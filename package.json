{
  "name": "tourism-planning",
  "version": "1.0.0",
  "private": true,
  "description": "Traditional Chinese travel planner with DeepSeek and Motion",
  "scripts": {
    "build:pages": "node scripts/build-pages.cjs",
    "codex:bridge": "node codex-bridge.cjs",
    "test": "node --test tests/*.test.cjs",
    "sync:motion": "node scripts/sync-motion.cjs",
    "check:motion": "node scripts/sync-motion.cjs --check",
    "sync:pdfjs": "node scripts/sync-pdfjs.cjs",
    "check:pdfjs": "node scripts/sync-pdfjs.cjs --check",
    "sync:tesseract": "node scripts/sync-tesseract.cjs",
    "check:tesseract": "node scripts/sync-tesseract.cjs --check"
  },
  "dependencies": {
    "@tesseract.js-data/chi_tra": "1.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "motion": "14.2.0",
    "pdfjs-dist": "6.4.299",
    "tesseract.js": "7.0.0",
    "tesseract.js-core": "7.0.0"
  }
}
